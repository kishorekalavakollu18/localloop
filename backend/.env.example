# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/localloop?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/localloop

# JWT Secret for authentication & Socket.io GPS token verification
JWT_SECRET=your_jwt_secret_key_here

# Environment (development or production)
NODE_ENV=development

# Geocoding & Road Routing Engine
# High accuracy offline PIN code dictionary included built-in.
# OpenStreetMap Nominatim: https://nominatim.openstreetmap.org
# OSRM Driving Engine: https://router.project-osrm.org
